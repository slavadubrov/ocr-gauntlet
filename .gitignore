# Downloaded samples — never commit dataset content
data/samples/*.png
data/samples/*.txt
data/samples/manifest.json

# Keep the directory itself
!data/samples/.gitkeep

# Standard Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
dist/
build/
*.whl
*.so

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment
.env

# OS
.DS_Store

# uv.lock is tracked for reproducible environments.

# Local datasets, raw OCR outputs, caches (can contain document text)
data/*/
!data/samples/
results/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
